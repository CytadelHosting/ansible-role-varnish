# Géré par Ansible (rôle varnish) - ne pas éditer à la main.
# Override PARTIEL : le unit livré par le paquet n'est jamais modifié.
# On réinitialise ExecStart (ligne vide obligatoire) puis on le redéfinit
# avec les paramètres du rôle (adresse d'écoute, admin, storage, etc.).
[Service]
ExecStart=
ExecStart=/usr/sbin/varnishd -a {{ varnish_listen_address }}:{{ varnish_listen_port }} -T {{ varnish_admin_listen_host }}:{{ varnish_admin_listen_port }}{% if varnish_pidfile %} -P {{ varnish_pidfile }}{% endif %} -f {{ varnish_config_path }}/default.vcl -S {{ varnish_config_path }}/secret -s {{ varnish_storage }}{% if varnishd_extra_options %} {{ varnishd_extra_options }}{% endif %}
